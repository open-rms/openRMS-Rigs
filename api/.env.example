# Own database on the shared Postgres instance (no service reads another's database).
DATABASE_URL=postgres://openrms_rigs:openrms_rigs@127.0.0.1:5442/openrms_rigs
HOST=127.0.0.1
PORT=8790
PUBLIC_URL=http://localhost:8790
# JWT audience (default: PUBLIC_URL). Set it to your deployment's public API URL.
OPENRMS_AUDIENCE=http://localhost:8790
# Trusted Accounts issuer(s), comma-separated: your openRMS-Accounts instance.
OPENRMS_ISSUER=http://localhost:8789
# Tests/offline only: a local stub issuer instead of Accounts. `pnpm dev-token` writes
# .dev/jwks.json and prints a token; then set OPENRMS_ISSUER=http://localhost:8789 too.
# DEV_JWKS_FILE=.dev/jwks.json
SITE_ORIGINS=http://localhost:5174
